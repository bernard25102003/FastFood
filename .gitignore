# ==============================================================================
# FASTFOOD ROOT .GITIGNORE (Production Security & Clean Repository)
# ==============================================================================

# ─── 1. Security, Private Keys & Certificates ────────────────────────────────
*.key
*.pem
*.id_rsa
*.id_ed25519
*.pub
id_rsa*
id_ed25519*
*.pfx
*.p12
*.crt
*.cer
*.der
*.kdbx
129.221.241.47.key

# ─── 2. Environment Variables & Secrets ──────────────────────────────────────
# Ignore all .env files across root and all subprojects
.env
.env.*
*.env
**/.env
**/.env.*
# But ALWAYS keep and track template sample & public production config files
!**/.env.example
!**/.env.sample
!**/.env.template
!**/.env.production

# ─── 3. Rust (Backend) ────────────────────────────────────────────────────────
target/
**/target/
**/*.rs.bk
Cargo.lock.bak

# ─── 4. Node.js & Frontend (User & Admin Client) ─────────────────────────────
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
out/
**/out/
.vite/
**/.vite/
.next/
.turbo/
.cache/

# NPM / Yarn / PNPM logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── 5. Database & Local Storage ─────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db
*.db-journal
*.sql.gz
*.sql.bak
dump.rdb

# ─── 6. Operating System Files ───────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# ─── 7. IDE, Editors & Tooling ───────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~

# ─── 8. Temporary Files & Local Shell Scripts ────────────────────────────────
*.log
logs/
**/logs/
tmp/
temp/
*.tmp
*.bak
deploy_*.sh
redeploy_*.sh
test_*.js
test_*.rs
run_*.sh
inspect_*.sh
