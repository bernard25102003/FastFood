# ==============================================================================
# FASTFOOD RUST BACKEND - SAMPLE CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your actual credentials:
#   cp .env.example .env
# ==============================================================================

# ─── 1. SERVER CONFIGURATION ─────────────────────────────────────────────────
PORT=3000
ENVIRONMENT=development
RUST_LOG=info,fastfood_backend=debug

# ─── 2. DATABASE CONFIGURATION (TiDB Cloud MySQL 8.0 Serverless) ─────────────
# Local development:
# DATABASE_URL=mysql://root:password@127.0.0.1:3306/fastfood_db
# TiDB Cloud Serverless (Public Gateway with TLS enabled):
DATABASE_URL=mysql://<USERNAME>.root:<PASSWORD>@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/fastfood_db?ssl-mode=REQUIRED

# ─── 3. JWT AUTHENTICATION ───────────────────────────────────────────────────
# Generate random 32+ character strings for production security
JWT_SECRET=your_super_secret_fastfood_jwt_access_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_fastfood_jwt_refresh_key_change_in_production
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=30

# ─── 4. CORS ALLOWED ORIGINS ─────────────────────────────────────────────────
# Comma-separated allowed frontend origins (without trailing slash)
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,https://ff.mio.io.vn,https://admin-ff.mio.io.vn

# ─── 5. BREVO (SENDINBLUE) EMAIL SERVICE ─────────────────────────────────────
# Used for real Email OTP on registration & forgot password
# Get your API Key at: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=no-reply@yourdomain.com
BREVO_SENDER_NAME="FastFood Vietnam"

# ─── 6. SEPAY VIETQR PAYMENT & WEBHOOK ───────────────────────────────────────
# Bank account details for dynamic VietQR generation
SEPAY_BANK_NAME=MBBank
SEPAY_ACCOUNT_NO=012345678999
SEPAY_ACCOUNT_NAME="FASTFOOD STORE"

# SePay Webhook Secret Token (HMAC-SHA256 Secret or API Key)
# Configured in SePay Dashboard (https://my.sepay.vn) -> Webhooks
# Format for HMAC-SHA256 starts with "whsec_..."
SEPAY_WEBHOOK_SECRET=whsec_your_sepay_webhook_secret_here

# SePay REST API Token (Optional, for active reconciliation & on-demand verify)
# Get from SePay Dashboard -> Settings / Tích hợp API -> API Tokens
SEPAY_API_KEY=your_sepay_api_token_here

# ─── 7. IMAGEKIT MEDIA STORAGE ───────────────────────────────────────────────
# Get credentials at: https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_PUBLIC_KEY=public_your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=private_your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
